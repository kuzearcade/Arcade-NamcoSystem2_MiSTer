+	// ORACLE PATCH: NS2_MUTE_YM / NS2_MUTE_C140 silence one chip's route, so each
+	// can be measured alone against the core (GingaNin GN-5's method)
+	if (getenv("NS2_MUTE_YM"))
+		subdevice<device_sound_interface>("ymsnd")->set_output_gain(ALL_OUTPUTS, 0.0);
+	if (getenv("NS2_MUTE_C140"))
+		m_c140->set_output_gain(ALL_OUTPUTS, 0.0);
+
+	// ORACLE PATCH: NS2_QUANTUM_HZ=n interleaves the CPUs every 1/n s, finer
+	// than the driver's quantum, so a handshake between CPUs resolves at the
+	// times the board's would (Arcade-NamcoSystem2_MiSTer NS2-8)
+	if (const char *q = getenv("NS2_QUANTUM_HZ"))
+		machine().scheduler().add_quantum(attotime::from_hz(atoi(q)), attotime::never);
+}
+
+u16 namcos2_base_state::key_rng()
+{
+	if (!machine().side_effects_disabled())
+		m_key_rng = (m_key_rng >> 1) ^ ((m_key_rng & 1) ? 0xb400 : 0);
+	return m_key_rng;
 }
 
