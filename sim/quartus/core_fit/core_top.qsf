# M4's first fit of the core: ./build.sh (map | fit)
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY core_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
# small RAMs (FIFOs, shift registers) in logic, not a whole M10K each
set_global_assignment -name AUTO_RAM_TO_LCELL_CONVERSION ON
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SEARCH_PATH ../../../rtl/third_party/fx68k
set_global_assignment -name SEARCH_PATH ../../../rtl
set_global_assignment -name SDC_FILE core_top.sdc
set_global_assignment -name SYSTEMVERILOG_FILE core_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_cpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c148.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_key.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c123.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_roz.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c45.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c169.sv
