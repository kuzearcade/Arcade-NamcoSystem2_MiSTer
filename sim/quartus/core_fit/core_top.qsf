# the probe's ports other than the clocks and the SDRAM are virtual pins (the
# MiSTer framework drives them in the real top)
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to dl
set_instance_assignment -name VIRTUAL_PIN ON -to dl_wr
set_instance_assignment -name VIRTUAL_PIN ON -to dl_addr*
set_instance_assignment -name VIRTUAL_PIN ON -to dl_data*
