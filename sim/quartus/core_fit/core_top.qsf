set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c65.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c68.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_m740.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_sound.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_c140.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_rom_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_bank_arb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/ns2_tile_filter.sv
set_global_assignment -name VERILOG_FILE ../../../rtl/ns2_hd63705.v
