# Namco System 2 -- the file list for the NamcoS2 .rbf.
# Add files HERE, never through the Quartus IDE.
set_global_assignment -name SEARCH_PATH rtl/third_party/fx68k
set_global_assignment -name SEARCH_PATH rtl

# Top level and clocks
set_global_assignment -name SYSTEMVERILOG_FILE NamcoS2.sv
set_global_assignment -name VERILOG_FILE rtl/pll_ns2.v

# Video output chain
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video_retime.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/third_party/crt_adjust/rtl/crt_vsize.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/third_party/crt_adjust/rtl/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/crt_chain.sv

# The board, its SDRAM side and the chips
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ns2_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ns2_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ns2_cpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ns2_c148.sv
